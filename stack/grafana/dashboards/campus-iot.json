{
  "uid": "campus-iot",
  "title": "Campus Inteligente · IoT (VLAN 60)",
  "tags": [
    "umg",
    "iot",
    "esp32"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-campus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-campus"
          },
          "query": "from(bucket: \"campus\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"temp\")\n  |> last()\n  |> keep(columns: [\"_value\", \"node\"])\n  |> group(columns: [\"node\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "displayName": "${__field.labels.node}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
                "color": "orange",
                "value": 27
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Humedad actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-campus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-campus"
          },
          "query": "from(bucket: \"campus\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"hum\")\n  |> last()\n  |> keep(columns: [\"_value\", \"node\"])\n  |> group(columns: [\"node\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "decimals": 1,
          "displayName": "${__field.labels.node}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 25
              },
              {
                "color": "blue",
                "value": 75
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Señal Wi-Fi (RSSI)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-campus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-campus"
          },
          "query": "from(bucket: \"campus\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"rssi\")\n  |> last()\n  |> keep(columns: [\"_value\", \"node\"])\n  |> group(columns: [\"node\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 1,
          "displayName": "${__field.labels.node}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -80
              },
              {
                "color": "green",
                "value": -67
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperatura por nodo (°C)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-campus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-campus"
          },
          "query": "from(bucket: \"campus\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"node\"])\n  |> group(columns: [\"node\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Humedad relativa por nodo (%)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-campus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {

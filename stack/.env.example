# Copie a .env y cambie las contraseñas antes de la demo.
MQTT_PLATFORM_PASS=platform-umg-2026
MQTT_ESP32_PASS=esp32-umg-2026
MQTT_TELEGRAF_PASS=telegraf-umg-2026

# Perfil "grafana" (opcional)
INFLUX_ADMIN_PASS=influx-umg-2026
INFLUX_TOKEN=umg-campus-token-cambiar
GRAFANA_ADMIN_PASS=grafana-umg-2026

# 1 = arranca 4 ESP32 simulados dentro de la plataforma (útil sin hardware)
SIMULATE=1
